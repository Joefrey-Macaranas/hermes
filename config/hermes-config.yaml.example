# Non-secret Hermes configuration example for the Hermes Autonomous Developer.
# Copy values into ~/.hermes/config.yaml via `hermes config set <key> <value>` (preferred),
# or use this file as a reference while editing `hermes config edit`.
# NEVER put API keys, bot tokens, or passwords in this file — secrets go in ~/.hermes/.env.

# --- Phase 2: terminal scope ----------------------------------------
terminal:
  backend: local          # required by the brief: execute on this Mac
  cwd: "~/Developer"      # set to YOUR workspace path before using
  timeout: 180

# --- Phase 2/6: toolsets --------------------------------------------
# Enable interactively with `hermes tools`; this documents the intended set.
# platform_toolsets:
#   cli: [terminal, file, web, search, browser, memory, skills, todo, vision]
#   hermes-telegram: [terminal, file, memory, skills, todo]

# --- Phase 5/9: observability ---------------------------------------
display:
  tool_progress: all      # off | new | all — report tool activity to chat

# --- Phase 8: approval posture (keep approvals ON) ------------------
# approvals:
#   mode: manual          # manual | smart — never off for unattended work
# computer_use:
#   permission_mode: bounded   # bounded requires a reviewed capability manifest
#   capability_manifest: ~/.hermes/cua-manifest.yaml

# --- Phase 3: Telegram (secrets live in .env, not here) -------------
# gateway:
#   platforms:
#     telegram:
#       enabled: true

# Secrets that belong in ~/.hermes/.env instead:
#   TELEGRAM_BOT_TOKEN=...        (from @BotFather)
#   TELEGRAM_ALLOWED_USERS=123456789   (your numeric Telegram user id)

# --- Phase 4: computer use ------------------------------------------
# computer_use runs in the background (no cursor warp / focus steal) via cua-driver.
# Verify with: hermes computer-use doctor